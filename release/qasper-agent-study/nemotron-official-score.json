    {
      "question_id": "qasper_test_993d5bef2bf1c0cd537342ef76d4b952f0588b83",
      "source_question_id": "993d5bef2bf1c0cd537342ef76d4b952f0588b83",
      "predicted_answer": "The paper \"The Social Dynamics of Language Change in Online Networks\" (Twitter data) tracks **written online language innovations** spreading through Twitter's social network, specifically **phonetic spellings** (e.g., \"gonna\", \"wanna\") and **netspeak abbreviations** (e.g., \"lol\", \"omg\"). It finds **complex contagion for these written innovations** but explicitly states it does **NOT** find contagion for **older dialect markers from spoken language** (offline spoken dialects). The contagion tracked is for **written online language change**, not spoken dialect changes.",
      "prediction_missing": false,
      "answer_f1": 0,
      "matched_answer_type": "none",
      "matched_reference_index": 0,
      "reference_count": 1,
      "reference_answer_types": [
